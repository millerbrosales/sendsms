# Railway will provide DATABASE_URL after you add Postgres.
DATABASE_URL=sqlite:///./millerbros.db

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Protect the upload/dashboard page.
APP_PASSWORD=change-this-to-a-long-password
SESSION_SECRET=change-this-to-a-long-random-string

# Used when normalizing 10-digit US numbers.
DEFAULT_COUNTRY=US

# Times below are interpreted in this timezone.
APP_TIMEZONE=America/Chicago

# First message is queued this many minutes after import.
WELCOME_DELAY_MINUTES=1

# Reminder timing relative to install date.
REMINDER_DAYS_BEFORE=2
FOLLOWUP_DAYS_AFTER=1

# Time of day for reminder/follow-up messages.
MESSAGE_HOUR_LOCAL=10
